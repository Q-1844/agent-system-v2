    "loc_1552fd4e32da": {
      "location_id": "loc_1552fd4e32da",
      "name": "雨后河岸与栈桥",
      "description": "A riverbank after heavy rain: silvery overcast sky with clouds parting, a wide river with gentle ripples reflecting light, an old wooden pier/boardwalk extending from the bank into the river, wet wooden planks glistening, grassy bank with reeds. Distant low hills. 2D hand-drawn storybook style, soft watercolor textures, muted silver-blue palette.",
      "identity_description": "Old weathered wooden pier with wooden posts and simple railings extending into a wide river; grassy riverbank with reeds; low hills across the water; silver-grey after-rain sky.",
      "style_notes": "2D hand-drawn storybook, soft watercolor",
      "created_at": 1790510918.5775158,
      "updated_at": 1790510918.5775163
    },
    "loc_8b686b5f555f": {
      "location_id": "loc_8b686b5f555f",
      "name": "夜间修理间",
      "description": "A cozy repair workshop at night: warm yellow desk lamp glow, sturdy wooden workbench with tools, small drawers and shelves on the stone wall, a heavy wooden door leading outside; rain streaks on a small window. 2D hand-drawn storybook style, warm amber light against deep blue night shadows.",
      "identity_description": "Small stone-and-timber workshop interior; central wooden workbench; warm hanging desk lamp; heavy wooden door; small window with rain streaks; tools and jars on shelves.",
      "style_notes": "2D hand-drawn storybook, soft watercolor",
      "created_at": 1790510967.8710558,
      "updated_at": 1790510967.871056
    },
    "loc_212643ad898c": {
      "location_id": "loc_212643ad898c",
      "name": "灯塔门厅与灯室",
      "description": "Interior of an old lighthouse at night: ground-floor hall with a spiral stone staircase winding upward, rough stone walls; at the top a lamp room with a large empty lamp seat and window openings facing the river. 2D hand-drawn storybook style, cool blue night tones with warm lantern glow.",
      "identity_description": "Round stone lighthouse interior; spiral stone staircase with wooden handrail winding counterclockwise upward; top lamp room with glazing panels, a large brass lamp seat, and window openings overlooking the river.",
      "style_notes": "2D hand-drawn storybook, soft watercolor",
      "created_at": 1790511013.9007854,
      "updated_at": 1790511013.900786
    }
  },
