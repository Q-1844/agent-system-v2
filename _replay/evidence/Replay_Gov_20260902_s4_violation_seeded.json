 "story_text": "《风暴灯塔》短片分镜：台风深夜，孤立灯塔。老船长陈海锋的渔船在近海引擎失灵，他通过无线电发出求救。【创作硬约束】陈海锋 / 老船长全程只通过无线电声音出现，始终不视觉出镜，绝不在画面里出现——观众始终只闻其声、不见其人。灯塔守林晚星（船医）与少年小满听到呼叫后组织救援，海岸警卫顾岩带队抵达海上施救，在风浪中救起老船长（老船长仍只在船舱内 / 被裹在担架里，未露面）。最后风暴减弱，老船长被送医（不出镜），林晚星在灯塔归还老船长的怀表。请基于此为各故事段设计分镜。",
 "characters": [
  {
   "name": "陈海锋",
   "description_en": "an old sea captain, weathered face, grey beard, yellow raincoat (radio-only, never on-screen)",
   "views": {}
  },
  {
   "name": "林晚星",
   "description_en": "a young woman in a doctor coat, the lighthouse keeper, determined eyes",
   "views": {}
  },
  {
   "name": "小满",
   "description_en": "a teenager boy in a raincoat, eager and brave",
   "views": {}
  },
  {
   "name": "顾岩",
   "description_en": "a coast guard officer in uniform, athletic build",
   "views": {}
  }
 ],
 "scenes": [
  {
   "scene_id": "s01",
   "title": "风起呼叫",
   "location": "灯塔监听室 / 近海",
   "time_of_day": "深夜",
   "summary": "台风深夜，孤立灯塔。老船长陈海锋的渔船在近海引擎失灵，他通过无线电发出求救（只闻其声，不见其人）。灯塔守林晚星与少年小满在塔顶监听室听到呼叫，林晚星接报、安抚老船长，记录方位。",
   "characters": [
    "陈海锋",
    "林晚星",
    "小满"
   ],
   "shots": [
    {
     "shot_id": "s01_c01",
     "scene_id": "s01",
     "index": 1,
     "description": "深夜，台风肆虐的近海。一座孤立的石砌灯塔矗立在汹涌的黑色海浪中，灯塔顶端光束穿透雨幕，扫过起伏的浪峰。远处海面漆黑一片，偶尔有闪电照亮翻滚的波涛。环境充满压迫感，灯塔是唯一的光源与秩序象征。",
     "prompt_en": "",
     "negative_prompt": "",
     "shot_size": "extreme wide shot",
     "camera": "",
     "lighting": "侧逆光为主，灯塔光束作为主光源照亮雨雾与浪花边缘，整体偏冷蓝黑色调，闪电瞬间补光",
     "motion": "巨浪翻滚拍打礁石，雨幕倾斜，灯塔光束规律旋转扫过海面",
     "characters": [],
     "dialogue": "",
     "opening_state": "灯塔静止矗立，光束从左向右旋转",
     "camera_angle": "low angle",
     "composition": "灯塔位于画面偏右侧三分之一处，占据垂直主导，海浪从左侧涌入画面，形成对角线构图，光束斜向切割黑暗",
