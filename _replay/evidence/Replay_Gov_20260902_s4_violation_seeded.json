    {
     "shot_id": "s01_c04",
     "scene_id": "s01",
     "index": 4,
     "description": "过肩镜头，从林晚星身后拍摄，她的肩膀与侧脸在前景左侧虚化，画面中心是小满与墙上的海图/雷达屏幕。小满指着屏幕上的某个位置，神情紧张但专注。林晚星一边记录方位数据，一边继续通过对讲机安抚对方，语气平静而专业。",
     "prompt_en": "",
     "negative_prompt": "",
     "shot_size": "medium close-up",
     "camera": "",
