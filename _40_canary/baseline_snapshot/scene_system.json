    "loc_db2b48908019": {
      "location_id": "loc_db2b48908019",
      "name": "天空",
      "description": "",
      "identity_description": "Vast sky in 2D animation style, with drifting white clouds and soft golden-hour lighting. The scene is an open aerial expanse above a forest and lake landscape, with a gentle gradient from pale blue at the zenith to warm cream near the horizon. Clouds are stylized with soft edges and subtle shading, evoking a serene natural atmosphere.",
      "style_notes": "",
      "created_at": 1790418645.7698634,
      "updated_at": 1790418645.7698636
    },
    "loc_33bd14817564": {
      "location_id": "loc_33bd14817564",
      "name": "森林边缘",
      "description": "2D animation style forest edge: rolling canopy of green treetops stretching across the landscape, with a distant lake visible as a silver reflection on the horizon. Lush evergreen and deciduous trees with soft layered greens.",
      "identity_description": "Forest edge in 2D animation style: a sweeping vista of green tree canopy stretching to the horizon, with a distant lake visible as a silver reflective patch. The forest is dense but not dark—soft dappled light filters through the canopy. Colors range from deep emerald in the foreground to pale jade and mint in the distance, consistent with the project's elegant natural landscape aesthetic.",
      "style_notes": "",
      "created_at": 1790418736.7202206,
      "updated_at": 1790418736.720221
    },
    "loc_92e17556bf7c": {
      "location_id": "loc_92e17556bf7c",
      "name": "湖泊",
      "description": "2D animation style tranquil lake scene featuring calm water surface with gentle ripples, reflecting the sky above. The water is clear and still near the center where the crane will land gracefully.",
      "identity_description": "Serene lake in 2D animation style: calm, mirror-like water surface reflecting the sky and surrounding natural landscape. Clear, still waters with subtle ripple effects around the landing zone. Soft natural lighting with gentle color palette emphasizing tranquility and reflection.",
      "style_notes": "",
      "created_at": 1790418970.516408,
      "updated_at": 1790418970.5164082
    }
  },
