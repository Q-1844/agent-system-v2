  "narration_cues": [
    {
      "cue_id": "na01",
      "shot_id": "s01_c04",
      "start_ms": 500,
      "end_ms": 5469,
      "duration_ms": 4969,
      "text": "暴雨过后，河面上只剩下一盏被摔坏的旧铜灯。",
      "voice_id": "Gentleman",
      "why": "场景转换：从船头紧张对峙（s01_c03）切到雨停 aftermath，点出核心道具"
    },
    {
      "cue_id": "na02",
      "shot_id": "s02_c02",
      "start_ms": 40000,
      "end_ms": 44029,
      "duration_ms": 4029,
      "text": "修理间的灯亮了，铜灯里的火苗也醒了。",
      "voice_id": "Gentleman",
      "why": "关键转折：人物动机明确化——修灯不是普通修理，是唤醒"
    },
    {
      "cue_id": "na03",
      "shot_id": "s02_c03",
      "start_ms": 58500,
      "end_ms": 61762,
      "duration_ms": 3262,
      "text": "它捧着灯，沿石阶一圈圈向上走。",
      "voice_id": "Gentleman",
      "why": "行为动作：仪式感的上升路径，连接修理间与塔顶"
    },
    {
      "cue_id": "na04",
      "shot_id": "s03_c01",
      "start_ms": 66500,
      "end_ms": 70053,
      "duration_ms": 3553,
      "text": "灯座上的铜灯亮起，光束扫过河面。",
      "voice_id": "Gentleman",
      "why": "高潮：灯亮瞬间，视觉奇观用文字强化"
    },
    {
      "cue_id": "na05",
      "shot_id": "s03_c04",
      "start_ms": 82500,
      "end_ms": 86854,
      "duration_ms": 4354,
      "text": "远处的船看见了光，调转船头，往回走。",
      "voice_id": "Gentleman",
      "why": "收尾：归航完成，呼应标题，留白不煽情"
    }
  ],
